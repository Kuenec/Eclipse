<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.kuenec.Eclipse</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Eclipse</name>
  <summary>Run the Android Roblox client on Linux</summary>
  <developer id="io.github.kuenec">
    <name>Kuenec</name>
  </developer>
  <description>
    <p>
      Eclipse is an open-source runtime, written in Rust, that runs the official and unmodified
      Android x86-64 Roblox client on Linux with native Vulkan graphics, audio, and keyboard and
      mouse input.
    </p>
    <p>
      Eclipse does not include or redistribute Roblox. On first launch it downloads Roblox's own
      release files and installs them only when Roblox Corporation's signature verifies, then keeps
      the client updated. It can also install official APK files from your Downloads folder.
    </p>
  </description>
  <launchable type="desktop-id">io.github.kuenec.Eclipse.desktop</launchable>
  <url type="homepage">https://github.com/Kuenec/Eclipse</url>
  <url type="bugtracker">https://github.com/Kuenec/Eclipse/issues</url>
  <url type="vcs-browser">https://github.com/Kuenec/Eclipse</url>
